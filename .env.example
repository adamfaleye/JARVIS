# Copy to .env and fill in. Never share this file.
ANTHROPIC_API_KEY=
# Only if your key isn't tied to a workspace (error mentions anthropic-workspace-id):
ANTHROPIC_WORKSPACE_ID=
ELEVENLABS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
# Optional: your A2P messaging service (MG...). Numbers you buy in JARVIS get added to it automatically.
TWILIO_MESSAGING_SERVICE_SID=
# AI Sidekicks Instagram assistant for @aisidekicks (see AISIDEKICKS.md). Leave empty until the Meta app is set up.
AISIDEKICKS_IG_APP_SECRET=
AISIDEKICKS_IG_VERIFY_TOKEN=
AISIDEKICKS_IG_ACCESS_TOKEN=
AISIDEKICKS_IG_ACCOUNT_ID=
# Phone line to your AI team (README 9j): the token @BotFather gives you. Never paste it anywhere else.
TELEGRAM_BOT_TOKEN=
