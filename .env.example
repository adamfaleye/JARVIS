# Copy to .env and fill in. Never share this file.
ANTHROPIC_API_KEY=
# Only if your key isn't tied to a workspace (error mentions anthropic-workspace-id):
ANTHROPIC_WORKSPACE_ID=
ELEVENLABS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
# Optional: your A2P messaging service (MG...). Numbers you buy in JARVIS get added to it automatically.
TWILIO_MESSAGING_SERVICE_SID=
